# Google Tag Manager
VITE_GTM_ID=GTM-NBQ7W9T6

# Telegram Bot Configuration
# Get your bot token from: https://t.me/BotFather
VITE_TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Chat ID
# Get your chat ID by sending /start to your bot and checking the message
VITE_TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: API for IP-based location detection
VITE_IPAPI_KEY=

# Calendly username (for booking widgets)
VITE_CALENDLY_USERNAME=thestorybuilder

# Environment
NODE_ENV=development
